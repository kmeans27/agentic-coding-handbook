+class RenewalError(ValueError):
+    """Raised when a loan cannot be renewed under the current policy."""
+
+
+def renew(loan: Loan, member: Member, today: int) -> Loan:
+    if loan.returned_day is not None:
+        raise RenewalError("returned loans cannot be renewed")
+    if member.suspended:
+        raise RenewalError("suspended members cannot renew")
+    if today > loan.due_day:
+        raise RenewalError("overdue loans cannot be renewed")
+    if loan.renewals >= MAX_RENEWALS:
+        raise RenewalError(f"renewal limit of {MAX_RENEWALS} reached")
+    loan.due_day += DEFAULT_LOAN_DAYS
+    loan.renewals += 1
+    return loan
+
+
 def borrow(member: Member, book: Book, loans: list[Loan]) -> Loan:
     loan = Loan(member_id=member.id, book_id=book.id, due_day=DEFAULT_LOAN_DAYS)
     loans.append(loan)
